// in SWISH – Online SWI-Prolog Compiler

% person(Name, date(Day, Month, Year))
person(arun, date(12, 3, 2004)).
person(bala, date(25, 7, 2003)).
person(chitra, date(5, 11, 2004)).
person(divya, date(18, 3, 2005)).
person(elango, date(30, 1, 2003)).

dob(Name, D/M/Y) :-
    person(Name, date(D, M, Y)).

born_in_year(Name, Year) :-
    person(Name, date(_, _, Year)).

born_in_month(Name, Month) :-
    person(Name, date(_, Month, _)).

older(P1, P2) :-
    person(P1, date(D1, M1, Y1)),
    person(P2, date(D2, M2, Y2)),
    P1 \= P2,
    ( Y1 < Y2
    ; Y1 =:= Y2, M1 < M2
    ; Y1 =:= Y2, M1 =:= M2, D1 < D2
    ).

Queries and outputs
Run each query separately in the Query box.

1. Query
dob(chitra, X).
Output:
X = 5/11/2004.

2. Query
born_in_year(N, 2004).
Output:
N = arun ;
N = chitra.

3. Query
born_in_month(N, 3).
Output:
N = arun ;
N = divya.

4. Query
older(bala, arun).
Output:
true.

5. Query
person(Name, date(_, _, 2003)).
Output:
Name = bala ;
Name = elango.
